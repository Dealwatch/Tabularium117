{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    }
  ],
  "uid": "tabularium117",
  "title": "Tabularium 117",
  "description": "The Anno 117 economy from Tabularium 117's /metrics endpoint: deficits, balance, efficiency and the connection. Needs Tabularium 117 v0.1.0-beta.2 or later.",
  "tags": [
    "anno117",
    "tabularium117"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Tabularium 117",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "https://github.com/Dealwatch/Tabularium117",
      "tooltip": "Project page"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(count by (session_guid, session_name) (tabularium117_island_info))",
        "definition": "query_result(count by (session_guid, session_name) (tabularium117_island_info))",
        "regex": "/session_guid=\"(?<value>[^\"]+)\".*session_name=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "options": [],
        "hide": 0,
        "current": {},
        "description": "One session at a time: island numbers repeat between sessions, so only within one session does a number name one island."
      },
      {
        "name": "island",
        "label": "Island",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(tabularium117_island_info{session_guid=\"$session\"})",
        "definition": "query_result(tabularium117_island_info{session_guid=\"$session\"})",
        "regex": "/island_id=\"(?<value>[^\"]+)\".*island_name=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "options": [],
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "product",
        "label": "Good",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(tabularium117_product_info)",
        "definition": "query_result(tabularium117_product_info)",
        "regex": "/product_guid=\"(?<value>[^\"]+)\".*product_name=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "options": [],
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Connection",
      "description": "Whether the source connection is open (pipe connected or recording playing). It does not say the statistics are usable: see Protocol.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(tabularium117_connection_up)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Connected",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Not connected",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last frame",
      "description": "Time since the last frame from the game. Anno 117 sends statistics about every two minutes.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(tabularium117_last_frame_timestamp_seconds)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Islands",
      "description": "Islands in the current picture, in all sessions. The pipe reports the player's own islands.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(tabularium117_islands)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Deficits",
      "description": "How many island and good combinations of the selection have a negative balance.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(tabularium117_product_balance_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} < 0) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Statistics",
      "description": "Right after a save loads, the game reports every island empty for up to two minutes. The goods series are absent meanwhile rather than zero.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(tabularium117_warming_up)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Live",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Waiting for first tick",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Protocol",
      "description": "Pipe protocol version the game announced. Tabularium 117 reads version 2; with any other version the pipe stays connected but statistics are ignored.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(tabularium117_protocol_version)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Current deficits",
      "description": "Every good with a negative balance, largest deficit first.",
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(\n  (tabularium117_product_balance_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} < 0)\n  * on (product_guid) group_left (product_name) tabularium117_product_info\n  * on (session_guid, island_id) group_left (island_name) tabularium117_island_info\n)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "session_guid": true,
              "island_id": true,
              "product_guid": true
            },
            "indexByName": {
              "island_name": 0,
              "product_name": 1,
              "Value": 2
            },
            "renameByName": {
              "island_name": "Island",
              "product_name": "Good",
              "Value": "Balance / min"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "custom": {
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Balance / min"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Balance per minute",
      "description": "Balance of each good, summed over the selected islands. Negative is a deficit. Narrow it down with the Good selector above.",
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 10,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (product_name) (\n  tabularium117_product_balance_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} * on (product_guid) group_left (product_name) tabularium117_product_info\n)",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{product_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": null,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "sortBy": "Last *",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Efficiency",
      "description": "Actual production against the potential if every building worked at 100 %, per good over the selected islands. Boosts can take it above 100 %.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (product_name) (\n  tabularium117_product_generation_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} * on (product_guid) group_left (product_name) tabularium117_product_info\n)\n/\n(sum by (product_name) (\n  tabularium117_product_perfect_generation_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} * on (product_guid) group_left (product_name) tabularium117_product_info\n) > 0)",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{product_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": null,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "sortBy": "Last *",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Production and consumption",
      "description": "Production and consumption per minute of the selected goods over the selected islands. Most useful with one or a few goods selected.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (product_name) (\n  tabularium117_product_generation_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} * on (product_guid) group_left (product_name) tabularium117_product_info\n)",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{product_name}} production"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (product_name) (\n  tabularium117_product_consumption_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} * on (product_guid) group_left (product_name) tabularium117_product_info\n)",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "{{product_name}} consumption"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": null,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "min"
          ],
          "sortBy": "Last *",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "All goods",
      "description": "Every good of the selection, summed over the selected islands, as it stands now.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (product_name) (\n  tabularium117_product_generation_per_minute{session_guid=\"$session\",island_id=~\"$island\",product_guid=~\"$product\"} * on (product_guid) group_left (product_name) tabularium117_product_info\n)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
